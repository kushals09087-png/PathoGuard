# ==============================================================================
# Genome Firewall — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Next.js)
# ------------------------------------------------------------------------------
# API Base URL for backend FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# When set to 'false', the frontend directly calls the live FastAPI backend
# When set to 'true', frontend uses the in-memory fallback provider
NEXT_PUBLIC_USE_MOCK_API=false

# Demo Access Key for development / demo API calls (sent via X-Access-Key)
NEXT_PUBLIC_DEMO_ACCESS_KEY=DemoPassword123!

# ------------------------------------------------------------------------------
# Backend API Environment Variables (FastAPI)
# ------------------------------------------------------------------------------
ENV=development
API_V1_PREFIX=/api/v1

# Secret key for token signing and session authentication (minimum 32 bytes)
SECRET_KEY=genome-firewall-secure-production-secret-key-32bytes-min

# MongoDB Database Connection
# If unset or unreachable, backend seamlessly uses durable disk JSON persistence (data/db/db_store.json)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=genome_firewall

# File Storage Configuration
FILE_STORAGE_PATH=data/storage
MAX_UPLOAD_BYTES=52428800 # 50 MB

# Worker Configuration
# In production, worker runs in separate process: python -m apps.worker.main
# Set INLINE_WORKER=true to run background analysis worker inside API process
INLINE_WORKER=false
WORKER_POLL_INTERVAL=1.0
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# AMRFinderPlus CLI Path (Optional - defaults to system PATH)
# If not installed, backend uses validated golden reference fixtures
AMRFINDER_PATH=amrfinder
